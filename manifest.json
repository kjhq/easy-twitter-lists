{
    "name": "Twitter Easy List",
    "version": "1.0",
    "manifest_version": 3,
    "content_scripts": [
        {
            "matches": [
                "https://x.com/*"
            ],
            "js": [
                "content_add_lists.js",
                "content_html.js",
                "content_initalize_list.js",
                "content_is_profile.js",
                "content.js"
            ]
        }
    ],
    "permissions": [
        "webRequest",
        "scripting",
        "activeTab",
        "cookies"
    ],
    "host_permissions": [
        "https://x.com/*"
    ],
    "background": {
        "service_worker": "background.js"
    }
}